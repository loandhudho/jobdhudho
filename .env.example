# PostgreSQL on Supabase (Prisma 6)
# Use the Supabase Transaction Pooler URL for DATABASE_URL (port 6543).
# Use the Supabase Direct connection URL for DIRECT_URL (port 5432).
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Auth / Storage (to be configured when those features are implemented)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# WhatsApp provider credentials — server-side only; never use NEXT_PUBLIC_
WHATSAPP_PROVIDER="gupshup"
WHATSAPP_API_KEY=""
WHATSAPP_APP_ID=""
WHATSAPP_SOURCE_NUMBER=""
